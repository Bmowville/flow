{
  "name": "flow",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:generate && npm run db:deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "validate:schema": "node scripts/validate-prisma-schema.mjs",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema prisma/postgres/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/postgres/schema.prisma",
    "db:generate:local": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:local": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.2.12",
    "next-auth": "^4.24.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.2",
    "jsdom": "^25.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
